configfile: "config.yaml"

RUN_CONFIG = config["run_config"]
CHECKPOINT = "output_gpurec/checkpoints/best.pt"
SUMMARY = "output_gpurec/summary.json"


rule all:
    input:
        summary = SUMMARY,
        sample_dir = "output_gpurec/reconciliations",


rule validate:
    input:
        run_json = RUN_CONFIG,
    output:
        marker = "output_gpurec/.validate_ok",
    shell:
        """
        gpurec validate-config --config {input.run_json} \
          --check-preprocess \
          --require-mode-default-optimizer \
          --require-cuda-backward-ready
        touch {output.marker}
        """


rule optimize:
    input:
        marker = rules.validate.output.marker,
    output:
        summary = SUMMARY,
        best_ckpt = CHECKPOINT,
    shell:
        """
        gpurec optimize --config {RUN_CONFIG} \
          --require-mode-default-optimizer \
          --require-converged \
          --require-final-check-ok
        """


rule inspect:
    input:
        summary = rules.optimize.output.summary,
        checkpoint = rules.optimize.output.best_ckpt,
    output:
        marker = "output_gpurec/.inspect_ok",
    shell:
        """
        gpurec summary-info --summary {input.summary} \
          --require-converged \
          --require-final-check-ok
        gpurec checkpoint-info --checkpoint {input.checkpoint} \
          --require-final-check-ok
        touch {output.marker}
        """


rule sample:
    input:
        checkpoint = rules.optimize.output.best_ckpt,
        marker = rules.inspect.output.marker,
    output:
        rec_dir = directory("output_gpurec/reconciliations"),
    shell:
        """
        gpurec sample \
          --checkpoint {input.checkpoint} \
          --samples {config[sample_count]} \
          --seed {config[sample_seed]} \
          --sample-out-dir output_gpurec
        """
